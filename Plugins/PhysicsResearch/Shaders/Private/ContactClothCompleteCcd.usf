#include "/Engine/Public/Platform.ush"

StructuredBuffer<float4> CcdStartPositions;
StructuredBuffer<float4> CcdCandidatePositions;
StructuredBuffer<float4> CcdCollisionSpheres;
StructuredBuffer<float4> CcdCollisionCapsuleStarts;
StructuredBuffer<float4> CcdCollisionCapsuleEnds;
RWStructuredBuffer<float4> CcdOutputPositions;

uint CcdParticleCount;
uint CcdColumns;
uint CcdSphereCount;
uint CcdCapsuleCount;
float CcdSafetyOffsetCm;

bool SweepSphere(float3 Start, float3 Delta, float3 Center, float Radius, out float OutTime, out float3 OutNormal)
{
    const float3 Offset = Start - Center;
    const float A = dot(Delta, Delta);
    const float B = 2.0 * dot(Offset, Delta);
    const float C = dot(Offset, Offset) - Radius * Radius;
    const float StartDistance = length(Offset);
    if (StartDistance <= Radius + 1.e-5)
    {
        const float3 StartNormal = StartDistance > 1.e-6 ? Offset / StartDistance : float3(0.0, 0.0, 1.0);
        if (dot(Delta, StartNormal) < 0.0)
        {
            OutTime = 0.0;
            OutNormal = StartNormal;
            return true;
        }
        return false;
    }
    if (A <= 1.e-8)
    {
        return false;
    }
    const float Discriminant = B * B - 4.0 * A * C;
    if (Discriminant < 0.0)
    {
        return false;
    }
    const float Time = (-B - sqrt(Discriminant)) / (2.0 * A);
    if (Time < 0.0 || Time > 1.0)
    {
        return false;
    }
    const float3 HitPosition = Start + Time * Delta;
    OutTime = Time;
    OutNormal = normalize(HitPosition - Center);
    return true;
}

float3 ClosestPointOnSegment(float3 Point, float3 SegmentStart, float3 SegmentEnd)
{
    const float3 Segment = SegmentEnd - SegmentStart;
    const float SegmentLengthSquared = dot(Segment, Segment);
    const float Alpha = SegmentLengthSquared > 1.e-8
        ? saturate(dot(Point - SegmentStart, Segment) / SegmentLengthSquared)
        : 0.0;
    return SegmentStart + Alpha * Segment;
}

bool SweepCapsule(float3 Start, float3 Delta, float3 CapsuleStart, float3 CapsuleEnd, float Radius, out float OutTime, out float3 OutNormal)
{
    const float3 StartClosest = ClosestPointOnSegment(Start, CapsuleStart, CapsuleEnd);
    const float3 StartOffset = Start - StartClosest;
    const float StartDistance = length(StartOffset);
    if (StartDistance <= Radius + 1.e-5)
    {
        const float3 StartNormal = StartDistance > 1.e-6 ? StartOffset / StartDistance : float3(0.0, 1.0, 0.0);
        if (dot(Delta, StartNormal) < 0.0)
        {
            OutTime = 0.0;
            OutNormal = StartNormal;
            return true;
        }
        return false;
    }

    const float3 Axis = CapsuleEnd - CapsuleStart;
    const float AxisLengthSquared = dot(Axis, Axis);
    if (AxisLengthSquared <= 1.e-8)
    {
        return SweepSphere(Start, Delta, CapsuleStart, Radius, OutTime, OutNormal);
    }
    const float3 OriginOffset = Start - CapsuleStart;
    const float DeltaLengthSquared = dot(Delta, Delta);
    const float AxisDotDelta = dot(Axis, Delta);
    const float AxisDotOrigin = dot(Axis, OriginOffset);
    const float DeltaDotOrigin = dot(Delta, OriginOffset);
    const float OriginLengthSquared = dot(OriginOffset, OriginOffset);
    const float A = AxisLengthSquared * DeltaLengthSquared - AxisDotDelta * AxisDotDelta;
    const float B = AxisLengthSquared * DeltaDotOrigin - AxisDotOrigin * AxisDotDelta;
    const float C = AxisLengthSquared * OriginLengthSquared - AxisDotOrigin * AxisDotOrigin - Radius * Radius * AxisLengthSquared;
    float EarliestTime = 2.0;
    float3 EarliestNormal = 0.0;
    const float Discriminant = B * B - A * C;
    if (abs(A) > 1.e-8 && Discriminant >= 0.0)
    {
        const float CylinderTime = (-B - sqrt(Discriminant)) / A;
        const float AxisPosition = AxisDotOrigin + CylinderTime * AxisDotDelta;
        if (CylinderTime >= 0.0 && CylinderTime <= 1.0 && AxisPosition >= 0.0 && AxisPosition <= AxisLengthSquared)
        {
            const float3 HitPosition = Start + CylinderTime * Delta;
            const float3 Closest = ClosestPointOnSegment(HitPosition, CapsuleStart, CapsuleEnd);
            EarliestTime = CylinderTime;
            EarliestNormal = normalize(HitPosition - Closest);
        }
    }
    float CapTime = 0.0;
    float3 CapNormal = 0.0;
    if (SweepSphere(Start, Delta, CapsuleStart, Radius, CapTime, CapNormal) && CapTime < EarliestTime)
    {
        EarliestTime = CapTime;
        EarliestNormal = CapNormal;
    }
    if (SweepSphere(Start, Delta, CapsuleEnd, Radius, CapTime, CapNormal) && CapTime < EarliestTime)
    {
        EarliestTime = CapTime;
        EarliestNormal = CapNormal;
    }
    if (EarliestTime > 1.0)
    {
        return false;
    }
    OutTime = EarliestTime;
    OutNormal = EarliestNormal;
    return true;
}

[numthreads(THREADGROUP_SIZE, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint ParticleIndex = DispatchThreadId.x;
    if (ParticleIndex >= CcdParticleCount)
    {
        return;
    }
    const float3 Candidate = CcdCandidatePositions[ParticleIndex].xyz;
    if (ParticleIndex < CcdColumns)
    {
        CcdOutputPositions[ParticleIndex] = float4(Candidate, 1.0);
        return;
    }

    const float3 Start = CcdStartPositions[ParticleIndex].xyz;
    const float3 Delta = Candidate - Start;
    float EarliestTime = 2.0;
    float3 EarliestNormal = 0.0;
    for (uint SphereIndex = 0; SphereIndex < CcdSphereCount; ++SphereIndex)
    {
        const float4 Sphere = CcdCollisionSpheres[SphereIndex];
        float HitTime = 0.0;
        float3 HitNormal = 0.0;
        if (SweepSphere(Start, Delta, Sphere.xyz, Sphere.w, HitTime, HitNormal) && HitTime < EarliestTime)
        {
            EarliestTime = HitTime;
            EarliestNormal = HitNormal;
        }
    }
    for (uint CapsuleIndex = 0; CapsuleIndex < CcdCapsuleCount; ++CapsuleIndex)
    {
        const float4 CapsuleStart = CcdCollisionCapsuleStarts[CapsuleIndex];
        const float3 CapsuleEnd = CcdCollisionCapsuleEnds[CapsuleIndex].xyz;
        float HitTime = 0.0;
        float3 HitNormal = 0.0;
        if (SweepCapsule(Start, Delta, CapsuleStart.xyz, CapsuleEnd, CapsuleStart.w, HitTime, HitNormal) && HitTime < EarliestTime)
        {
            EarliestTime = HitTime;
            EarliestNormal = HitNormal;
        }
    }
    const float3 OutputPosition = EarliestTime <= 1.0
        ? Start + EarliestTime * Delta + CcdSafetyOffsetCm * EarliestNormal
        : Candidate;
    CcdOutputPositions[ParticleIndex] = float4(OutputPosition, 0.0);
}
